; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="CifraLetra"
config/description="CifraLetra - pasatiempo "
run/main_scene="uid://bvpri1mtnymgf"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="uid://dbl6g80hlkm50"

[autoload]

GameManager="*res://autoload/GameManager.gd"
SoundManager="*res://autoload/SoundManager.tscn"
SignalManager="*res://autoload/SignalManager.gd"
TestResolution="*res://autoload/test_resolution.gd"
TransitionScreen="*res://scenes/transition_screen.tscn"
PlayerPrefs="*res://autoload/PlayerPrefs.gd"
HistoryManager="*res://autoload/HistoryManager.gd"
PlayFabTools="*res://autoload/PlayFab.tscn"
Analyzer="*res://autoload/Analyzer.gd"

[display]

window/size/viewport_width=1024
window/size/viewport_height=1920
window/size/initial_position_type=4
window/size/initial_position=Vector2i(0, 100)
window/size/always_on_top=true
window/stretch/mode="viewport"
window/handheld/orientation=6

[editor_plugins]

enabled=PackedStringArray("res://addons/alignment-tool/plugin.cfg")

[input]

dev_force_portrait={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":80,"key_label":0,"unicode":112,"location":0,"echo":false,"script":null)
]
}
dev_force_landscape={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":76,"key_label":0,"unicode":108,"location":0,"echo":false,"script":null)
]
}

[input_devices]

pointing/android/enable_pan_and_scale_gestures=true
pointing/emulate_touch_from_mouse=true

[internationalization]

locale/fallback="es"

[playfab]

title_id="1BC2FD"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
